PORT=4000
REDIS_URL=redis://127.0.0.1:6379
MONGO_URL=mongodb://127.0.0.1:27017/limitguard
CLIENT_ORIGIN=http://localhost:5173

# What to do when Redis is unreachable: "open" lets traffic through, "closed" rejects it
FAIL_MODE=open

# Rules are cached in memory and refreshed on this interval (ms)
RULE_CACHE_TTL_MS=5000
